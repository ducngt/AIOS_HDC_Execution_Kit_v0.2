        "invariants": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "INV-IDENTITY-ROLE"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "invariants": {
