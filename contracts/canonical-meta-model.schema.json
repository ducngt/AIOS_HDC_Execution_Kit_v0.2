{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-meta-model.schema.json",
  "title": "AIOS Canonical Meta-Model Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta_model_id",
    "version",
    "namespace",
    "concept_families",
    "invariants",
    "versioning"
  ],
  "properties": {
    "meta_model_id": {
      "type": "string",
      "pattern": "^CMM-[A-Za-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "concept_families": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "Identity",
              "Organization",
              "Role",
              "Context",
              "Authority",
              "Delegation",
              "Policy",
              "Semantic",
              "Capability",
              "Contract",
              "Domain",
              "Work",
              "Decision",
              "Evidence",
              "Event",
              "Agent",
              "Change"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "left",
          "relation",
          "right",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "INV-IDENTITY-ROLE",
              "INV-ROLE-AUTHORITY",
              "INV-CAPABILITY-AUTHORITY",
              "INV-EVIDENCE-DECISION",
              "INV-AI-RECOMMENDATION-DECISION",
              "INV-DOMAIN-ORGANIZATION",
              "INV-CURRENT-STATE-HISTORY",
              "INV-REGISTRY-SOURCE-CODE"
            ]
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "const": "distinct_from"
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "compatibility_policy",
        "reference_policy"
      ],
      "properties": {
        "scheme": {
          "const": "semantic-versioning"
        },
        "compatibility_policy": {
          "type": "string",
          "minLength": 1
        },
        "reference_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Identity"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Organization"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Role"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Context"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Authority"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Delegation"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Policy"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Semantic"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Capability"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Contract"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Domain"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Work"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Decision"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "concept_families": {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "Evidence"
              }
            },
            "required": [
              "name"
