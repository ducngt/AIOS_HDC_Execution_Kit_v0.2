{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-identity.schema.json",
  "title": "AIOS Canonical Identity Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "object_type",
    "version",
    "namespace"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "object_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  }
}
