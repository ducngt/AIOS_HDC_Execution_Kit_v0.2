{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-lifecycle.schema.json",
  "title": "AIOS Canonical Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current_state",
    "lifecycle_state"
  ],
  "properties": {
    "current_state": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "history_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "provenance_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    }
  }
}
