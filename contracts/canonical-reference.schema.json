{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-reference.schema.json",
  "title": "AIOS Canonical Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_id",
    "target_type",
    "relation"
  ],
  "properties": {
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "target_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "relation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "version_constraint": {
      "type": "string",
      "minLength": 1
    }
  }
}
