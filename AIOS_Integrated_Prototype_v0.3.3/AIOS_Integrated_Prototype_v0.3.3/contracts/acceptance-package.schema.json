{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-package.schema.json",
  "title": "HDC Acceptance Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_id",
    "task_id",
    "change_id",
    "evidence_id",
    "decision_record",
    "decision"
  ],
  "properties": {
    "acceptance_id": {
      "type": "string",
      "pattern": "^AP-[A-Za-z0-9._-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "change_id": {
      "type": "string",
      "pattern": "^CP-[A-Za-z0-9._-]+$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EE-[A-Za-z0-9._-]+$"
    },
    "decision_record": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "changes_requested"
      ]
    }
  }
}
