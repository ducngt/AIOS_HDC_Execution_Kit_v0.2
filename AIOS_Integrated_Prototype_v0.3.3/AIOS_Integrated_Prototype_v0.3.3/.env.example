# Runtime
AIOS_HOST=0.0.0.0
AIOS_PORT=8000
# Set AIOS_DB_PATH to a persistent volume/path when desired.
# AIOS_DB_PATH=/workspaces/.aios-data/aios-prototype.sqlite3

# Provider secrets (never commit actual keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AIOS_COMPATIBLE_API_KEY=

# Optional provider/model overrides
AIOS_OPENAI_MODEL=gpt-5.6-luna
AIOS_ANTHROPIC_MODEL=claude-sonnet-5
AIOS_GEMINI_MODEL=gemini-3.8-flash
AIOS_COMPATIBLE_BASE_URL=
AIOS_COMPATIBLE_MODEL=
