{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract.schema.json",
  "title": "HDC Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "version",
    "status",
    "objective",
    "human_gate_required",
    "implementation_allowed_before_gate"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "contracted",
        "gated",
        "implementing",
        "testing",
        "verified",
        "replayed",
        "evidenced",
        "awaiting_acceptance",
        "accepted"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "implementation_allowed_before_gate": {
      "type": "boolean"
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "record"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "record": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
